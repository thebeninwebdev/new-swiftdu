# false redirects website pages to /suspended except /tasker-signup and its nested routes.
# Normal live orders remain blocked.
# Authorized test/training orders may still proceed through the API; their pages redirect too.
# Only the exact value true enables operations. Missing values default to suspended.
OPERATIONS_ENABLED=false

# Shared SwiftDU MongoDB connection. Atlas must use a replica set or sharded cluster for transactions.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Public SwiftDU origin used for links generated by the standalone order API.
SWIFTDU_BASE_URL=https://www.swiftdu.org
# Render supplies PORT automatically; set only for local service runs.
PORT=10000

# Shared only by SwiftDU (Vercel) and Sammy (Render). Never expose as NEXT_PUBLIC_*.
SAMMY_SWIFTDU_INTERNAL_SECRET=

# Server-only Ably key for publishing and issuing browser subscription tokens.
ABLY_API_KEY=

# Shared by the Vercel app and the persistent Render Node process for giveaway socket auth.
GIVEAWAY_SOCKET_SECRET=
# Server-resolved public URL of the Render realtime process. Set this on Vercel.
GIVEAWAY_SOCKET_URL=
# Backward-compatible build-time URL. The giveaway client now prefers GIVEAWAY_SOCKET_URL.
NEXT_PUBLIC_SOCKET_URL=
# Comma-separated browser origins allowed to connect to the Render realtime process.
GIVEAWAY_ALLOWED_ORIGINS=https://swiftdu.org,https://www.swiftdu.org

# Public WDU Business Directory: server-side moderation (never NEXT_PUBLIC).
GEMINI_API_KEY=
# Defaults to gemini-3.1-flash-lite. Override with a model available to your project.
GEMINI_BUSINESS_REVIEW_MODEL=
# Reuses NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME, or set this server override.
CLOUDINARY_CLOUD_NAME=
# Server credentials for signed uploads and cleanup; never expose these publicly.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional SIGNED preset. Leave blank to use signed upload parameters directly.
CLOUDINARY_BUSINESS_UPLOAD_PRESET=

# Girls ID is provisional: add the bot and verify getChat before deployment.
TELEGRAM_GIRLS_ORDERS_CHAT_ID=-1004410762658
TELEGRAM_BOYS_ORDERS_CHAT_ID=-1004415332662
# Isolated Training Mode order channel. The bot must be an admin/member of it.
TELEGRAM_TRAINING_ORDERS_CHAT_ID=-1004495693547

# Conservative per-instance Mongoose pool settings (optional).
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# URL deployment behavior:
# Local: no URL variable is required; http://localhost:3000 is used.
# Vercel Preview: do not set NEXT_PUBLIC_BASE_URL/BASE_URL/BETTER_AUTH_URL to production.
# VERCEL_URL and VERCEL_BRANCH_URL are injected automatically by Vercel; Preview trusts those exact deployment and branch-alias origins.
# Production canonical URL: set SWIFTDU_BASE_URL and NEXT_PUBLIC_BASE_URL to https://www.swiftdu.org.
# Keep BETTER_AUTH_URL consistent if it is set; do not set production URL variables in Preview.

# Server-only semantic business discovery (768 dimensions).
GEMINI_BUSINESS_EMBEDDING_MODEL=gemini-embedding-2
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en_US
